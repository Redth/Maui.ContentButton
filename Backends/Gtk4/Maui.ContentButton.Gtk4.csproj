<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Plugin.Maui.ContentButton.Gtk4</PackageId>
    <Description>Native GTK4 ContentButton support for the experimental .NET MAUI Linux backend.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="$(MauiLabsGtk4Version)" />
    <ProjectReference Include="../Core/Maui.ContentButton.csproj" />
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
